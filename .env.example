# ─────────────────────────────────────────────────────────────────────────────
# RWA Tokenization Framework — Environment Variables
# Copy this file to `.env` and adjust as needed. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# --- Stellar Network ---------------------------------------------------------
# Which Stellar network to target: testnet | mainnet | futurenet
VITE_STELLAR_NETWORK=testnet

# Soroban RPC endpoint (defaults to the official testnet endpoint)
VITE_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase (defaults to the testnet passphrase)
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Horizon endpoint used for on-chain balance lookups (defaults to testnet)
VITE_HORIZON_URL=https://horizon-testnet.stellar.org

# --- Deployed Contract IDs (Soroban) ----------------------------------------
# Leave blank to run fully on demo data. When set, the contract client
# (src/lib/contracts/client.ts) is ready to call them via Soroban RPC.
VITE_RWA_FACTORY_CONTRACT=
VITE_INVESTOR_REGISTRY_CONTRACT=
VITE_DIVIDEND_DISTRIBUTOR_CONTRACT=
VITE_COMPLIANCE_MANAGER_CONTRACT=

# --- App Behavior ------------------------------------------------------------
# Demo mode lets judges and reviewers explore every page without a Freighter
# wallet. Set to "false" to require a real wallet for all sessions.
VITE_ENABLE_DEMO_MODE=true

# Feature flags (optional, defaults shown)
# VITE_FF_DIVIDENDDISTRIBUTION=true
# VITE_FF_INVESTORWHITELISTING=true
# VITE_FF_TRANSFERRESTRICTIONS=true
# VITE_FF_DARKMODE=true
# VITE_FF_CONTRACTDEPLOY=true
# VITE_FF_KYCPROVIDERCUSTOM=false

# --- Monitoring --------------------------------------------------------------
# Sentry DSN for error tracking (optional; errors fall back to console)
VITE_SENTRY_DSN=

# --- Bundle analysis (optional) ----------------------------------------------
# Run `ANALYZE=true npm run build` to emit dist/stats.html
# ANALYZE=true
